# Copiar como .env y completar los valores (sin comillas)

# Base de datos PostgreSQL (Neon / Supabase / cualquier Postgres)
# DATABASE_URL: cadena "pooled" (para la app en Vercel/serverless)
# DIRECT_URL:   cadena directa (la usa Prisma para migraciones / db push)
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require
DIRECT_URL=postgresql://usuario:password@host/db?sslmode=require

# Contraseña de acceso al panel de administración /admin
ADMIN_PASSWORD=admin123

# Firma de la sesión de administración (texto largo y aleatorio)
SESSION_SECRET=cambia-este-secret-largo-y-aleatorio

# Token de Mercado Pago (Dashboard > Tu integración > Credenciales de acceso)
# Si se deja vacío, el sitio funciona en MODO DEMO (pedidos aprobados sin cobro real)
MERCADO_PAGO_ACCESS_TOKEN=

# URL pública del sitio (para los back_urls de Mercado Pago y el webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary: almacenamiento de las fotos subidas desde el panel admin.
# Si estas tres variables están vacías, en local las fotos se guardan en public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=genitrini-hnos
