generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  title       String
  slug        String      @unique
  category    String
  kind        String      @default("usado")
  price       Float       @default(0)
  stock       Int         @default(1)
  condition   String      @default("Usado – buen estado")
  material    String      @default("")
  width       Float?
  height      Float?
  depth       Float?
  description String
  history     String?
  featured    Boolean     @default(false)
  visible     Boolean     @default(true)
  views       Int         @default(0)
  images      Image[]
  orderItems  OrderItem[]
  quoteItems  QuoteItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([visible])
  @@index([kind])
  @@index([material])
}

model Image {
  id        Int     @id @default(autoincrement())
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique
  buyerName    String
  buyerEmail   String
  buyerPhone   String      @default("")
  buyerMessage String      @default("")
  status       String      @default("pending")
  paymentId    String?
  preferenceId String?
  subtotal     Float       @default(0)
  total        Float       @default(0)
  demo         Boolean     @default(false)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  price     Float
  qty       Int
  image     String?

  @@index([orderId])
}

model Quote {
  id         String      @id @default(cuid())
  reference  String      @unique
  buyerName  String
  buyerPhone String      @default("")
  buyerEmail String      @default("")
  message    String      @default("")
  status     String      @default("pending")
  items      QuoteItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  qty       Int     @default(1)
  width     String  @default("")
  height    String  @default("")
  depth     String  @default("")
  material  String  @default("")
  note      String  @default("")

  @@index([quoteId])
}

model Setting {
  key   String @id
  value String
}
